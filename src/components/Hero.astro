---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import CEOImage from "@assets/images/ceo.webp";
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-content">
<h1>
  <span class="hero-highlight">Empowering</span> Your Business Growth
</h1>
      <p>
        Discover tailored strategies and expert insights to take your business
        to the next level. Let us help you navigate challenges and achieve
        sustainable success.
      </p>

      <div class="hero-actions">
        <a class="book-btn" href="#0">Book a Meeting</a>

        <a class="learn-btn" href="#0">
          <span>Learn More</span>

          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="16"
            viewBox="0 0 18 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M1 7.5454H17M10.4545 14.0909L17 7.5454L10.4545 1"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </div>

    <Image
      class="hero-image"
      src={CEOImage}
      alt="Business consultant"
    />
  </div>

  <Services />
</section>

<style>
  @layer components {
    .hero {
  position: relative;

  padding-bottom: var(--space-10);

  background-color: var(--color-ui-primary);
  color: var(--color-on-ui-primary);

  background-image:
    linear-gradient(
      color-mix(in srgb, var(--color-action) 12%, transparent) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      color-mix(in srgb, var(--color-action) 12%, transparent) 1px,
      transparent 1px
    );

  background-size: 75px 75px;
}

    .hero-inner {
      position: relative;

      display: grid;
      grid-template-columns: 1fr 1fr;

      max-width: var(--content-width);
      min-height: 500px;
      margin-inline: auto;
    }

    /* Text */

    .hero-content {
      position: relative;
      z-index: 1;

      display: flex;
      flex-direction: column;
      justify-content: center;

      padding: var(--space-10) var(--space-8) var(--space-11) 0;
    }

    .hero h1 {
      max-width: 500px;
      margin: 0 0 var(--space-5);

  font-family: var(--font-cabin), "Cabin", sans-serif;
      font-size: var(--font-size-3xl);
      font-weight: var(--font-weight-bold);
      line-height: var(--line-height-tight);

      color: var(--color-on-ui-primary);
    }

   .hero-highlight {
  position: relative;

  text-decoration-line: underline;
  text-decoration-color: var(--color-action);
  text-decoration-thickness: 6px;
  text-underline-offset: 4px;
  text-decoration-skip-ink: auto;
}

.hero-highlight::before {
  content: "";

  position: absolute;
  right: 100%;
  bottom: 1.5px;

  width: 100vw;
  height: 6px;

  background: linear-gradient(
    to right,
    var(--color-ui-primary) 0%,
    var(--color-action) 100%
  );
}

    .hero-content > p {
      max-width: 480px;
      margin: 0 0 var(--space-7);

      font-family: var(--font-body);
      font-size: var(--font-size-base);
      line-height: var(--line-height-body);

      color: var(--color-on-ui-primary-muted);
    }

    /* Buttons */

    .hero-actions {
      display: flex;
      align-items: center;
      gap: var(--space-4);
    }

    .book-btn,
    .learn-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      min-height: 52px;
      padding: var(--space-3) var(--space-6);

      border-radius: var(--radius-pill);

      font-family: var(--font-body);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);

      text-decoration: none;
    }

    .book-btn {
      background: var(--color-action);
      color: var(--color-text);
    }

    .learn-btn {
      gap: var(--space-3);

      border: 1px solid var(--color-text-weak);

      background: transparent;
      color: var(--color-on-ui-primary);
    }

    /* Image */

    .hero-image {
  width: calc(
    100% + max(0px, (100vw - var(--content-width)) / 2)
  );
  max-width: none;
  height: 100%;

  object-fit: cover;
  object-position: center top;
}
    /* Tablet */

    @media (max-width: 900px) {
      .hero-inner {
        padding-inline: var(--space-6);
      }

      .hero h1 {
        font-size: var(--font-size-2xl);
      }
    }

    /* Mobile */

    @media (max-width: 650px) {
      .hero-inner {
        grid-template-columns: 1fr;

        padding: var(--space-8) var(--space-5);
      }

      .hero-content {
        padding: 0 0 var(--space-7);
      }

      .hero-image {
        max-height: 450px;

        border-radius: var(--radius-md);
      }

      .hero-actions {
        flex-wrap: wrap;
      }
    }
  }
</style>