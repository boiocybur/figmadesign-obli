---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import CEOImage from "@assets/images/ceo.webp";
---

<section class="hero">
  <div class="hero-content">
    <h1>Empowering Your Business Growth</h1>
    <p>
      Discover tailored strategies and expert insights to take your business to
      the next level. Let us help you navigate challenges and achieve
      sustainable success.
    </p>
    <a class="book-btn" href="#0">Book a Meeting</a>
<a class="learn-btn" href="#0">
  <span>Learn More</span>
  <svg class="learn-btn__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="16" viewBox="0 0 18 16" fill="none" aria-hidden="true">
    <path d="M1 7.5454H17M10.4545 14.0909L17 7.5454L10.4545 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</a>  </div>
  <Image src={CEOImage} alt="CEO" />

  <Services />
</section>

<style>
  /* Styles her */
  @layer components {
    /* .hero {
      background-color: var(--color-neutrals-900);
      padding: 2rem;
      position: relative;
      min-height: 500px;
      overflow: hidden;
      padding: 2rem;
      color: #fff;
    } */
     .hero {
  background-color: var(--color-neutrals-900);
  padding: 2rem;
  position: relative;
  min-height: 500px;
  overflow: visible; /* ændret fra hidden, ellers klippes kortene */
  padding-bottom: 6rem; /* plads til at kortene kan "hænge" nedenfor */
  color: #fff;
}
    .hero > img{
      position: absolute;
      padding-top: 4rem;
      top: 0;
      right: 0;
      inset: 0;
      height: 80%;      
      object-fit: cover;
      z-index: 0;
      opacity: 0.8;
    }
    .hero-content{
      position: relative;
      z-index: 1;
      width: min(50%, 540px);
      padding-top: 4rem;
      margin-left: 10%;
    }

    .hero-actions{
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .book-btn{
      background-color: var(--color-yellow-500);
      color: var(--color-neutrals-900);
      border-radius: 42px;
      display: flex;
      padding: 16px 31px;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      gap: 10px;
      width: 189px; 
      height: 61px;
    }

    .learn-btn{
       background-color: var(--color-neutrals-900);
      color: #ffff;
      border-radius: 42px;
      border: 1px solid rgba(255, 255, 255, 0.50);
      background: var(--color-ui-primary, var(--color-neutrals-900));
      display: flex;
      padding: 16px 31px;
      align-items: center;
      gap: 16px;
      flex-direction: column;
      justify-content: center;
      width: 186px;
      height: 61px;
    }
    p {
      color: var(--color-on-ui-primary-muted, var(--color-neutrals-400));
      font-family: Lato;
      font-size: 18px;
      font-style: normal;
      font-weight: 400;
      line-height: 147.5%; /* 26.55px */
    }
    h1 {
      color: var(--color-on-ui-primary, var(--color-neutrals-50));
      font-family: Cabin;
      font-size: 50px;
      font-style: normal;
      font-weight: 700;
      line-height: 116%; /* 58px */
      text-decoration-line: underline;
      text-decoration-style: solid;
      text-decoration-skip-ink: auto;
      text-decoration-color: var(--color-yellow-500);
      text-decoration-thickness: 7px; /* 14% */
      text-underline-offset: 5px; /* 10% */
      text-underline-position: from-font;
    }
    
  }
</style>
