---
import { Image } from "astro:assets";

import Clap from "../data/images/clap.webp";
import Clap2 from "../data/images/clap2.webp";
import Sit from "../data/images/sit.webp";

import PhoneIcon from "../icons/phone.svg";
import ClockIcon from "../icons/clock.svg";
import PinIcon from "../icons/pin.svg";
---

<section class="contact">
  <div class="contact__inner">
    <div class="contact__content">
      <p class="contact__label">PROCESS</p>

      <h2>Contact Us. It’s Easy.</h2>

      <p class="contact__text">
        Leverage agile frameworks to provide a robust synopsis for high level
        overviews. Iterative approaches to corporate strategy foster collaborative.
      </p>

      <div class="contact__details">
        <div class="contact__item">
          <div class="contact__icon contact__icon--yellow">
            <img src={PhoneIcon.src} alt="" />
          </div>

          <div>
            <p>Call Today</p>
            <a href="tel:+1800100900">+1 800 100 900</a>
          </div>
        </div>

        <div class="contact__item">
          <div class="contact__icon contact__icon--green">
            <img src={ClockIcon.src} alt="" />
          </div>

          <div>
            <p>Monday To Friday</p>
            <strong>9AM - 5PM</strong>
          </div>
        </div>

        <div class="contact__item">
          <div class="contact__icon contact__icon--gray">
            <img src={PinIcon.src} alt="" />
          </div>

          <div>
            <p>USA Office</p>
            <strong>
              195 Devonshire St Boston, MA<br />
              02110
            </strong>
          </div>
        </div>
      </div>
    </div>

    <div class="contact__gallery">
      <div class="contact__green"></div>

      <div class="contact__main-image">
        <Image
          src={Sit}
          alt="Business professional"
        />
      </div>

      <div class="contact__side-images">
        <div class="contact__small-image">
          <Image
            src={Clap}
            alt="People working together"
          />
        </div>

        <div class="contact__small-image">
          <Image
            src={Clap2}
            alt="Business meeting"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @layer components {
    .contact {
      padding: var(--space-11) var(--space-8);
      background: var(--color-surface-primary);
    }

    .contact__inner {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      align-items: center;
      gap: var(--space-10);

      max-width: var(--content-width);
      margin-inline: auto;
    }

    .contact__content {
      max-width: 27rem;
    }

    .contact__label {
      margin: 0 0 var(--space-3);

      font-family: var(--font-body);
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-regular);
      letter-spacing: var(--letter-spacing-label);

      color: var(--color-text);
    }

    .contact h2 {
      margin: 0 0 var(--space-4);

      font-family: var(--font-heading);
      font-size: var(--font-size-2xl);
      font-weight: var(--font-weight-bold);
      line-height: var(--line-height-tight);

      color: var(--color-text);
    }

    .contact__text {
      margin: 0;

      font-family: var(--font-body);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-regular);
      line-height: var(--line-height-relaxed);

      color: var(--color-text-muted);
    }

    .contact__details {
      display: grid;
      gap: var(--space-7);

      margin-top: var(--space-8);
    }

    .contact__item {
      display: flex;
      align-items: center;
      gap: var(--space-4);
    }

    .contact__item p {
      margin: 0 0 var(--space-1);

      font-family: var(--font-body);
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-regular);

      color: var(--color-text-muted);
    }

    .contact__item strong,
    .contact__item a {
      font-family: var(--font-body);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);
      line-height: var(--line-height-body);

      color: var(--color-text);
      text-decoration: none;
    }

    .contact__item a:hover {
      text-decoration: underline;
    }

    .contact__icon {
      display: grid;
      place-items: center;

      width: var(--space-9);
      height: var(--space-9);

      flex-shrink: 0;

      border-radius: var(--radius-round);
    }

    .contact__icon img {
      width: var(--space-5);
      height: var(--space-5);
    }

    .contact__icon--yellow {
      background: var(--color-yellow-500);
    }

    .contact__icon--green {
      background: var(--color-green-400);
    }

    .contact__icon--gray {
      background: var(--color-surface-tertiary);
    }

    .contact__gallery {
      position: relative;

      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);

      min-height: 28rem;
    }

    .contact__green {
      position: absolute;
      left: calc(var(--space-9) * -1);
      bottom: calc(var(--space-6) * -1);

      width: 10rem;
      height: 8rem;

      border-radius: var(--radius-md);

      background: var(--color-ui-secondary);
    }

    .contact__main-image,
    .contact__small-image {
      position: relative;
      z-index: 1;

      overflow: hidden;

      border-radius: var(--radius-lg);
    }

    .contact__side-images {
      display: grid;
      grid-template-rows: 1fr 1fr;
      gap: var(--space-4);
    }

    .contact__main-image :global(img),
    .contact__small-image :global(img) {
      display: block;

      width: 100%;
      height: 100%;

      object-fit: cover;
    }

    @media (max-width: 900px) {
      .contact__inner {
        grid-template-columns: 1fr;
        gap: var(--space-9);
      }

      .contact__content {
        max-width: 40rem;
      }

      .contact__gallery {
        min-height: 24rem;
      }
    }

    @media (max-width: 600px) {
      .contact {
        padding: var(--space-10) var(--space-5);
      }

      .contact h2 {
        font-size: var(--font-size-xl);
      }

      .contact__gallery {
        grid-template-columns: 1fr;
        min-height: auto;
      }

      .contact__main-image {
        min-height: 22rem;
      }

      .contact__side-images {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 12rem;
      }

      .contact__green {
        left: calc(var(--space-4) * -1);
        bottom: calc(var(--space-4) * -1);

        width: 6rem;
        height: 6rem;
      }
    }

    @media (max-width: 450px) {
      .contact__side-images {
        grid-template-columns: 1fr;
        grid-template-rows: repeat(2, 12rem);
      }
    }
  }
</style>