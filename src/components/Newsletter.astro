---

---

<section class="newsletter">
  <span class="badge">Stay Updated</span>

  <h2>Subscribe Our Newsletter</h2>

  <p>
    Build stronger Customer Relationships with
    <span class="highlight">Consultalk</span>
  </p>

  <form class="newsletter-form">
    <input type="email" name="email" placeholder="your mail address" required />
    <button type="submit">Subscribe</button>
  </form>
</section>
<style>
  @layer components {
    .newsletter {
      padding: var(--space-9) var(--space-7);

      background-color: var(--color-ui-primary);
      color: var(--color-on-ui-primary);

      text-align: center;
    }

    /* Label */

    .badge {
      display: inline-block;

      margin-bottom: var(--space-2);

      font-family: var(--font-body);
      font-size: var(--font-size-base);
      font-weight: var(--font-weight-regular);
      line-height: var(--line-height-body);
      letter-spacing: var(--letter-spacing-label);
      text-transform: uppercase;

      color: var(--color-action);
    }

    /* Heading */

    .newsletter h2 {
      margin: 0 0 var(--space-3);

      font-family: var(--font-body);
      font-size: var(--font-size-xl);
      font-weight: var(--font-weight-bold);
      line-height: var(--line-height-tight);

      color: var(--color-on-ui-primary);
    }

    /* Description */

    .newsletter p {
      margin: 0 0 var(--space-7);

      font-family: var(--font-body);
      font-size: var(--font-size-sm);
      line-height: var(--line-height-body);

      color: var(--color-on-ui-primary-muted);
    }

    .highlight {
      color: var(--color-action);
      font-weight: var(--font-weight-semibold);
    }

    /* Form */

    .newsletter-form {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: var(--space-3);

      max-width: 480px;
      margin-inline: auto;
    }

    .newsletter-form input {
      flex: 1;

      min-width: 220px;
      padding: var(--space-3) var(--space-5);

      border: 1px solid var(--color-text-weak);
      border-radius: var(--radius-pill);

      background: transparent;
      color: var(--color-on-ui-primary);

      font-family: var(--font-body);
      font-size: var(--font-size-sm);
    }

    .newsletter-form input::placeholder {
      color: var(--color-on-ui-primary-muted);
    }

    .newsletter-form input:focus-visible {
      outline: 2px solid var(--color-action);
      outline-offset: var(--space-1);
      border-color: transparent;
    }

    /* Button */

    .newsletter-form button {
      padding: var(--space-3) var(--space-7);

      border: 0;
      border-radius: var(--radius-pill);

      background-color: var(--color-action);
      color: var(--color-text);

      font-family: var(--font-body);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);

      cursor: pointer;
      white-space: nowrap;
    }

    .newsletter-form button:hover {
      opacity: 0.9;
    }

    .newsletter-form button:focus-visible {
      outline: 2px solid var(--color-on-ui-primary);
      outline-offset: var(--space-1);
    }

    /* Mobile */

    @media (max-width: 500px) {
      .newsletter {
        padding: var(--space-8) var(--space-5);
      }

      .newsletter-form {
        flex-direction: column;
      }

      .newsletter-form input,
      .newsletter-form button {
        width: 100%;
      }
    }
  }
</style>
