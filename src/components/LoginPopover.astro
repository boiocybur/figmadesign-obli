<div id="login-popover" popover class="login-popover">
  <h2>Dashboard Login</h2>
  <form class="login-form">
    <div class="form-group">
      <label for="email">Email address</label>
      <input type="email" id="email" name="email" />
    </div>
    <div class="form-group">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" />
    </div>
    <button type="submit" class="submit-btn">Go to dashboard</button>
  </form>
</div>
<style>
  @layer components {
    .login-popover {
      position: fixed;
      position-anchor: --login-anchor;
      position-area: bottom span-left;

      width: 320px;
      margin-top: var(--space-3);
      padding: var(--space-7);

      border: none;
      border-radius: var(--radius-md);

      background: var(--color-surface-primary);
      color: var(--color-text);

      box-shadow: 0 20px 40px rgb(0 0 0 / 15%);

      opacity: 0;
      transform: translateY(-8px) scale(0.98);

      transition:
        opacity 250ms ease,
        transform 250ms ease,
        overlay 250ms allow-discrete,
        display 250ms allow-discrete;
    }

    .login-popover::backdrop {
      background: rgb(0 0 0 / 20%);
    }

    .login-popover:popover-open {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    @starting-style {
      .login-popover:popover-open {
        opacity: 0;
        transform: translateY(-8px) scale(0.98);
      }
    }


    /* Heading */

    .login-popover h2 {
      margin: 0 0 var(--space-6);

      font-family: var(--font-body);
      font-size: var(--font-size-xl);
      font-weight: var(--font-weight-bold);

      color: var(--color-text);
    }


    /* Form */

    .form-group {
      margin-bottom: var(--space-4);
    }

    .form-group label {
      display: block;

      margin-bottom: var(--space-2);

      font-family: var(--font-body);
      font-size: var(--font-size-sm);

      color: var(--color-text);
    }

    .form-group input {
      box-sizing: border-box;

      width: 100%;
      padding: 10px var(--space-3);

      border: 1px solid var(--color-surface-tertiary);
      border-radius: var(--radius-sm);

      background: var(--color-surface-primary);
      color: var(--color-text);

      font-family: var(--font-body);
      font-size: var(--font-size-sm);
    }

    .form-group input:focus-visible {
      outline: 2px solid var(--color-action);
      outline-offset: var(--space-1);
    }


    /* Submit */

    .submit-btn {
      width: 100%;
      padding: var(--space-3) 0;

      border: none;
      border-radius: var(--radius-pill);

      background-color: var(--color-action);
      color: var(--color-text);

      font-family: var(--font-body);
      font-weight: var(--font-weight-semibold);

      cursor: pointer;
    }

    .submit-btn:focus-visible {
      outline: 2px solid var(--color-text);
      outline-offset: var(--space-1);
    }


    /* Staggered animation */

    .login-popover h2,
    .login-popover .form-group,
    .login-popover .submit-btn {
      opacity: 0;
      transform: translateY(8px);
    }

    .login-popover:popover-open h2,
    .login-popover:popover-open .form-group,
    .login-popover:popover-open .submit-btn {
      animation: fade-in-up 350ms ease forwards;
    }

    .login-popover:popover-open h2 {
      animation-delay: 50ms;
    }

    .login-popover:popover-open .form-group:nth-of-type(1) {
      animation-delay: 120ms;
    }

    .login-popover:popover-open .form-group:nth-of-type(2) {
      animation-delay: 190ms;
    }

    .login-popover:popover-open .submit-btn {
      animation-delay: 260ms;
    }

    @keyframes fade-in-up {
      from {
        opacity: 0;
        transform: translateY(8px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>