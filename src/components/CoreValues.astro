---
import { getCoreValues } from "@lib/api";
import DynamicIcon from "@helpers/DynamicIcon.astro";

interface Props {
  variant?: "default" | "alt";
}

const { variant = "default" } = Astro.props;

const coreValuesData = await getCoreValues();
---

<section class:list={["values", `values--${variant}`]}>
  <div class="values-container">
    <div class="values-heading">
      <div>
        <span class="values-label">
          {coreValuesData.eyebrow}
        </span>

        <h2>{coreValuesData.title}</h2>
        <p>{coreValuesData.subtitle}</p>
      </div>

      <a href={coreValuesData.button.link} class="contact-button">
        {coreValuesData.button.text}
      </a>
    </div>

    <div class="values-grid">
      {
        coreValuesData.values.map((value) => (
          <article class="value-card">
            <div class="value-icon">
              <DynamicIcon
                name={value.icon}
                width={24}
                height={24}
              />
            </div>

            <h3>{value.title}</h3>

            <p>{value.description}</p>

            <a href={value.link.url}>
              {value.link.text}
              <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .values {
    container-type: inline-size;

    background: var(--color-surface-secondary);
  }

  .values-container {
    padding: var(--space-11) var(--space-8);
  }

  .values-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-8);

    max-width: var(--content-width);
    margin: 0 auto var(--space-8);
  }

  .values-heading > div {
    max-width: 600px;
  }

  .values-label {
    display: block;

    margin-bottom: var(--space-3);

    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-label);

    color: var(--color-text);
  }

  .values-heading h2 {
    margin: 0 0 var(--space-3);

    font-family: var(--font-heading);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);

    color: var(--color-text);
  }

  .values-heading p {
    margin: 0;

    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);

    color: var(--color-text-muted);
  }

  .contact-button {
    flex-shrink: 0;

    padding: var(--space-3) var(--space-7);

    border-radius: var(--radius-pill);

    background: var(--color-ui-primary);
    color: var(--color-on-ui-primary);

    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    text-decoration: none;
  }

  /* Grid */

  .values-grid {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    /*
      Fire fælles rækker:
      ikon, titel, tekst og link.
    */
    grid-template-rows:
      auto
      auto
      1fr
      auto;

    gap: var(--space-7);

    max-width: var(--content-width);
    margin-inline: auto;
  }

  /*
    Kortene bruger rækkerne fra parent-grid'et.
    Det gør, at indholdet står på linje på tværs
    af kortene.
  */
  .value-card {
    display: grid;

    grid-row: span 4;
    grid-template-rows: subgrid;

    min-width: 0;
    min-height: 300px;

    padding: var(--space-7) var(--space-6);

    border: 1px solid var(--color-surface-tertiary);
    border-radius: var(--radius-md);

    background: var(--color-surface-primary);
  }

  /* Icons */

  .value-icon {
    display: grid;
    place-items: center;

    width: 46px;
    height: 46px;

    border-radius: var(--radius-round);

    background: var(--color-ui-primary);
    color: var(--color-on-ui-primary);
  }

  /* Card content */

  .value-card h3 {
    margin: 0;

    font-family: var(--font-heading);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-bold);

    color: var(--color-text);
  }

  .value-card p {
    margin: 0;

    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);

    color: var(--color-text-muted);
  }

  .value-card > a {
    font-family: var(--font-body);
    font-size: var(--font-size-sm);

    color: var(--color-text);
    text-decoration: none;
  }

  .value-card > a:hover {
    text-decoration: underline;
  }

  .value-card > a span {
    margin-left: var(--space-1);
  }

  /* Alt variant */

  .values--alt {
    background: var(--color-ui-primary);
    color: var(--color-on-ui-primary);
  }

  .values--alt .values-label,
  .values--alt .values-heading h2 {
    color: var(--color-on-surface-elevated);
  }

  .values--alt .values-heading p {
    color: var(--color-on-ui-primary-muted);
  }

  .values--alt .contact-button {
    background: var(--color-surface-primary);
    color: var(--color-text);
  }

  .values--alt .value-card {
    background: var(--color-surface-secondary);
    border-color: var(--color-surface-tertiary);
  }

  .values--alt .value-card h3,
  .values--alt .value-card > a {
    color: var(--color-text);
  }

  .values--alt .value-card p {
    color: var(--color-text-muted);
  }

  .values--alt .value-icon {
    background: var(--color-ui-primary);
    color: var(--color-on-ui-primary);
  }

  /* Container query: tablet */

  @container (max-width: 900px) {
    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Container query: mobile */

  @container (max-width: 600px) {
    .values-container {
      padding: var(--space-10) var(--space-5);
    }

    .values-heading {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-6);
    }

    .values-heading h2 {
      font-size: var(--font-size-xl);
    }

    .values-grid {
      grid-template-columns: 1fr;
    }
  }
</style>