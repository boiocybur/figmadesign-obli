---
//@ts-nocheck
import { getCaseStudies } from "@lib/api";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths() {
  const caseStudies = await getCaseStudies();

  return caseStudies.map((caseStudy) => ({
    params: { slug: caseStudy.slug },
    props: { caseStudy },
  }));
}

const { caseStudy } = Astro.props;
const { caseName, category, date, image, buttonLabel } = caseStudy.caseDetails;
---

<Layout>
  <article class="case-story-article">
    <div class="case-intro">
      <span class="eyebrow">CASE STUDIES</span>
      <h1>{caseName}</h1>
      <p>
        Our achievements reflect the close collaboration between our expert
        teams and our esteemed clientele. We cultivate a workplace that
        champions peak performance and guarantees client satisfaction.
      </p>
    </div>
    <header>
      <Image
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
      />
      <div class="case-details">
        <dl>
          <div>
            <dt>Case Name</dt>
            <dd>{caseName}</dd>
          </div>
          <div>
            <dt>Category</dt>
            <dd class="category">{category}</dd>
          </div>
          <div>
            <dt>Date</dt>
            <dd class="date">{date}</dd>
          </div>
        </dl>
        <a href="#0" class="button">{buttonLabel}</a>
      </div>
    </header>
    <section class="case-story-content">
      {
        caseStudy.sections.map((section, index) => (
          <>
            {index === 0 ? (
              <h2>{section.title}</h2>
            ) : (
              <h3>{section.title}</h3>
            )}

            {Array.isArray(section.content) ? (
              <>
                {section.content.map((item) => (
                  <p>{item}</p>
                ))}
              </>
            ) : (
              <p>{section.content}</p>
            )}
            {section.highlights && (
              <ul>
                {section.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}
            {section.image && (
              <figure>
                <Image
                  src={section.image.src}
                  alt={section.image.alt}
                  width={section.image.width}
                  height={section.image.height}
                />
                {section.image.caption && (
                  <figcaption>{section.image.caption}</figcaption>
                )}
              </figure>
            )}
          </>
        ))
      }
    </section>
  </article>
</Layout>

<style>
  @layer components {
  .case-story-article {
    max-width: 900px;
    margin-inline: auto;
    padding: var(--space-9) var(--space-6) var(--space-11);

  }

  /* Intro */

  .case-intro {
    text-align: center;
    margin-bottom: var(--space-9);
  }

  .case-intro .eyebrow {
    display: block;
  margin-bottom: var(--space-4);

  font-family: var(--font-body);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-regular);
  line-height: var(--line-height-body);
  letter-spacing: var(--letter-spacing-label);

  color: var(--color-text);
  }

  .case-intro h1 {
  position: relative;
  display: inline-block;

  margin: 0 0 var(--space-7);

  font-family: var(--font-heading);
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
  line-height: var(--line-height-tight);

  color: var(--color-text);
}

.case-intro h1::after {
  content: "";

  position: absolute;
  right: 0;
  bottom: -10px;

  width: calc(50% + 50vw);
  height: 6px;

  background: var(--color-action);
}

  .case-intro p {
  max-width: 480px;
  margin: var(--space-6) auto 0;

  font-family: var(--font-body);
  font-size: var(--font-size-base);
  line-height: var(--line-height-body);

  color: var(--color-text-muted);
}


  /* Hero */

  header {
    position: relative;
    margin-bottom: var(--space-11);
  }

  header :global(img) {
    display: block;
    width: 100%;

    border-radius: var(--radius-md);
  }


  /* Case details */

  .case-details {
    position: absolute;
    left: 50%;
    bottom: 0;

    transform: translate(-50%, 50%);

    width: min(90%, 700px);
    padding: var(--space-6) var(--space-7);

    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);

    background: var(--color-surface-elevated);
    border-radius: var(--radius-md);
  }

  .case-details dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);

    margin: 0;
  }

  .case-details dt {
    margin-bottom: var(--space-1);

    font-family: var(--font-body);
    font-size: var(--font-size-xs);

    color: var(--color-on-ui-primary-muted);
  }

  .case-details dd {
    margin: 0;

    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);

    color: var(--color-on-surface-elevated);
  }

  .case-details .button {
    padding: 10px 22px;

    background: var(--color-action);
    color: var(--color-text);

    border-radius: var(--radius-pill);

    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);

    text-decoration: none;
    white-space: nowrap;
  }


  /* Case article content */

  .case-story-content {
    --flow-space: var(--space-4);
  }

  .case-story-content > * {
    margin-block: 0;
  }

  .case-story-content > * + * {
    margin-block-start: var(--flow-space);
  }

  .case-story-content h2 {
    --flow-space: var(--space-7);

    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);

    color: var(--color-text);
  }

  .case-story-content h3 {
    --flow-space: var(--space-8);

    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);

    color: var(--color-text);
  }

  .case-story-content p {
    font-family: var(--font-heading);
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed);

    color: var(--color-text-muted);
  }

  .case-story-content ul {
    --flow-space: var(--space-6);

    list-style: none;

    display: grid;
    gap: var(--space-3);

    padding: 0;
  }

  .case-story-content li {
    position: relative;

    padding-left: var(--space-7);

    font-family: var(--font-heading);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);

    color: var(--color-text-muted);
  }

  .case-story-content li::before {
    content: "•";

    position: absolute;
    left: 0;

    font-weight: var(--font-weight-bold);
  }

  .case-story-content figure {
    --flow-space: var(--space-7);
  }

  .case-story-content figure :global(img) {
    display: block;
    width: 100%;

    border-radius: var(--radius-md);
  }

  .case-story-content figcaption {
    margin-top: var(--space-3);

    font-family: var(--font-body);
    font-size: var(--font-size-xs);

    color: var(--color-text-weak);
  }


  /* Mobile */

  @media (max-width: 650px) {
    .case-story-article {
      padding-inline: var(--space-5);
    }

    .case-details {
      position: relative;
      left: auto;
      bottom: auto;

      width: 100%;
      margin-top: var(--space-4);

      transform: none;
    }

    .case-details dl {
      gap: var(--space-5);
    }

    header {
      margin-bottom: var(--space-9);
    }
  }
}
  </style>
